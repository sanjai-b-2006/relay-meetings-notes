# --- Required for extraction ---
OPENAI_API_KEY=sk-...
# Model used for extraction AND the filing agent (per challenge: GPT-5.6)
RELAY_MODEL=gpt-5.6

# --- Slack (optional — demo mode if missing) ---
# Bot token with chat:write + channels:read scopes
SLACK_BOT_TOKEN=xoxb-...
SLACK_TEAM_ID=T...
# Channel to post recaps into
SLACK_CHANNEL_ID=C...

# --- Linear (optional — demo mode if missing) ---
# Personal API key from linear.app/settings/api
LINEAR_API_TOKEN=lin_api_...
# Optional: team to create issues in (agent uses first team otherwise)
LINEAR_TEAM_ID=

# --- Notion (optional — demo mode if missing) ---
# Internal integration token from notion.so/my-integrations
NOTION_TOKEN=ntn_...
# Optional: parent page ID the integration has access to
NOTION_PARENT_PAGE_ID=
