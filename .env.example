# --- Model provider: fill in ONE of these two ---

# Option A: OpenAI platform (platform.openai.com)
OPENAI_API_KEY=sk-...

# Option B: OpenRouter (openrouter.ai) — OpenAI-compatible, has free models.
# If set, Relay uses OpenRouter for extraction AND the filing agent.
OPENROUTER_API_KEY=sk-or-...

# Model id. Default: gpt-5.6 (per challenge). On OpenRouter, bare OpenAI names
# are auto-prefixed to "openai/gpt-5.6"; or set any OpenRouter id, e.g.:
#   RELAY_MODEL=meta-llama/llama-3.3-70b-instruct:free
RELAY_MODEL=gpt-5.6

# --- Option 1: Composio (recommended — one OAuth login per app, no ---
# --- developer API keys to hunt for). See SETUP_TOKENS.md.        ---
# COMPOSIO_API_KEY=ak_...                          (dashboard.composio.dev -> Settings -> API Keys)
# COMPOSIO_TOOLS=slack,linear,notion               (which apps you connected)
# COMPOSIO_MCP_URL=                                (optional override; defaults to Composio's managed endpoint)

# --- Option 2: direct per-service tokens (demo mode if missing). ---
# --- See SETUP_TOKENS.md. Ignored if COMPOSIO_MCP_URL is set.    ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_TEAM_ID=T...
SLACK_CHANNEL_ID=C...

LINEAR_API_TOKEN=lin_api_...
LINEAR_TEAM_ID=

NOTION_TOKEN=ntn_...
NOTION_PARENT_PAGE_ID=
